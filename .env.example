# Copy this file to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_USE_X_FORWARDED_HOST=false

DATABASE_URL=postgresql://jeevasetu:replace-local-password@postgres:5432/jeevasetu
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5
POSTGRES_DB=jeevasetu
POSTGRES_USER=jeevasetu
POSTGRES_PASSWORD=replace-local-password

REDIS_URL=redis://redis:6379/0
AUTH_RATE_LIMIT_REDIS_URL=redis://redis:6379/1
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# Results are intentionally disabled when this is empty.
CELERY_RESULT_BACKEND=
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_SOFT_TIME_LIMIT=270
CELERY_TASK_TIME_LIMIT=300
CELERY_VISIBILITY_TIMEOUT=3600

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
DJANGO_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_ORGANIZATION_SLUG=jeevasetu-wellness
