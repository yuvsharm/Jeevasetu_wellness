# Copy this file to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_USE_X_FORWARDED_HOST=false

DATABASE_URL=postgresql://jeevasetu:replace-local-password@postgres:5432/jeevasetu
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5
POSTGRES_DB=jeevasetu
POSTGRES_USER=jeevasetu
POSTGRES_PASSWORD=replace-local-password

# Keep false for the local hashed-OTP fallback. Use only the dedicated JeevaSetu MSG91 resources.
MSG91_ENABLED=false
APPOINTMENT_REMINDER_OFFSETS_HOURS=24,2
MSG91_WIDGET_ID=your-jeevasetu-widget-id
MSG91_WIDGET_TOKEN=your-jeevasetu-web-widget-token
MSG91_AUTH_KEY=your-jeevasetu-backend-auth-key
MSG91_TIMEOUT_SECONDS=5
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=

REDIS_URL=redis://redis:6379/0
AUTH_RATE_LIMIT_REDIS_URL=redis://redis:6379/1
# Development-only final customer-registration limit; production remains pinned to 5/hour.
CUSTOMER_REGISTRATION_THROTTLE_RATE=30/hour
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# Results are intentionally disabled when this is empty.
CELERY_RESULT_BACKEND=
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_SOFT_TIME_LIMIT=270
CELERY_TASK_TIME_LIMIT=300
CELERY_VISIBILITY_TIMEOUT=3600

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
DJANGO_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_ORGANIZATION_SLUG=jeevasetu-wellness

# Optional server-only reverse geocoding. Leave blank until a provider is approved.
# The implemented adapter accepts "google". Never expose this key as NEXT_PUBLIC_*.
GEOCODING_PROVIDER=
GOOGLE_MAPS_GEOCODING_API_KEY=
